  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#86A78D", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#B8E986" } },
    { "name": "Numbers and constants", "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#E5C984" } },
    { "name": "Keywords", "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#78F03A" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#D5F59B" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#9AD9BC" } },
    { "name": "Variables", "scope": ["variable", "entity.name.variable", "variable.parameter"], "settings": { "foreground": "#E5F5E8" } },
    { "name": "Properties", "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#C6E7CA" } },
    { "name": "Tags", "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#78F03A" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#D5F59B" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace", "meta.delimiter"], "settings": { "foreground": "#A4C3AA" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF807A", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "namespace": "#9AD9BC",
    "type": "#9AD9BC",
    "class": "#9AD9BC",
    "interface": "#9AD9BC",
    "enum": "#9AD9BC",
    "typeParameter": "#BDEBDA",
    "function": "#D5F59B",
    "method": "#D5F59B",
    "property": "#C6E7CA",
    "variable": "#E5F5E8",
    "parameter": "#D8EBDD",
    "enumMember": "#E5C984",
    "keyword": "#78F03A",
    "comment": "#86A78D",
    "string": "#B8E986",
    "number": "#E5C984",
    "operator": "#A4C3AA",
    "variable.readonly": "#E5C984",
    "property.readonly": "#E5C984"
  }
